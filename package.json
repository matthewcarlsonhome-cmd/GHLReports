{
  "name": "ghlreports",
  "version": "0.1.0",
  "description": "GoHighLevel client reporting engine — pulls CRM data from the GHL API v2 and generates client-facing reports (HTML, CSV, JSON).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ghlreports": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
