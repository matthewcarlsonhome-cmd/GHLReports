# Collector secrets — copy to .env at the repo root for local runs.
# Exactly three secrets, ever (PITs live in Supabase Vault, not here).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
COLLECTOR_KEY=<the value bootstrapped into vault as 'collector_key'>

# Non-secret
GHL_APP_BASE=https://crm.smallscreenproducer.com
TZ=America/Chicago

# Optional Tier 2: Monday digest email per AM (skipped when unset)
# RESEND_API_KEY=<resend api key>
# DIGEST_FROM=health@smallscreenproducer.com
