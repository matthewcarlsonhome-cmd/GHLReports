# Collector secrets: copy to .env at the repo root for local runs. Never commit
# the copy (.gitignore already excludes .env). PITs live in Supabase Vault,
# never here. These three are all a local run needs; together they unlock
# every client's GHL token, so keep the file on your own machine only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
COLLECTOR_KEY=<the value bootstrapped into vault as 'collector_key'>

# Non-secret
GHL_APP_BASE=https://crm.smallscreenproducer.com
TZ=America/Chicago

# Optional secrets, set only where the Monday digest or the alert bridge runs
# (Render today). Listed so nobody is surprised they exist; leave them out of
# local .env files unless you are testing that exact feature.
#   SMTP_USER, SMTP_PASS      Google Workspace sender and its app password
#   DIGEST_CC                 comma list of @smallscreenproducer.com addresses
#   DIGEST_REDIRECT           one staff address that gets every AM's digest
#   DIGEST_ALLOWLIST          AMs who get their own digest; empty = nobody
#   AUTOMATION_WEBHOOKS       off | dry | on (kill switch, defaults to off)
#   AUTOMATION_WEBHOOK_URL    GHL inbound webhook URL; treat it as a secret
